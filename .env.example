# OPENAI_API_KEY: usada para traduzir perguntas importadas da OpenTDB e para
# gerar as perguntas de RPG em /api/generate-questions. Mesma conta/chave já
# usada pelo EduQuest. Configure no servidor/Vercel, nunca em variáveis
# VITE_ ou no navegador.
OPENAI_API_KEY="MY_OPENAI_API_KEY"
# Opcional. gpt-4.1-mini é o padrão econômico.
OPENAI_MODEL="gpt-4.1-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Banco interno de perguntas no Supabase. Use a Service Role Key apenas no servidor.
# Nunca exponha SUPABASE_SERVICE_ROLE_KEY em variáveis VITE_ ou no navegador.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="SUA_SERVICE_ROLE_KEY"

# Protege os endpoints de importação, revisão e publicação de perguntas.
ADMIN_API_SECRET="UM_SEGREDO_FORTE_E_ALEATORIO"

# A Vercel injeta e assina automaticamente as chamadas de cron com esta
# env var (Authorization: Bearer <CRON_SECRET>) quando ela está configurada
# no projeto — usada por /api/cron/refill-questions para reabastecer o
# banco de perguntas sozinho, sem depender de alguém clicar em "Importar".
CRON_SECRET="OUTRO_SEGREDO_FORTE_E_ALEATORIO"
